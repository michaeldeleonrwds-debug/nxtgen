<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Direct access to index.php
    RewriteRule ^index\.php$ - [L]

    # Route all other /api/* requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Protect sensitive files and configs
<FilesMatch "^\.|\.(env|sql|md|log|json|lock|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
